# ---- Supabase ----
# Create a project at https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Settings -> API -> service_role key. Backend-only. NEVER expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Settings -> Database -> Connection string (used by seed scripts / direct SQL if needed)
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ---- LLM providers (backend-only, never exposed to frontend) ----
# https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
# "groq" or "gemini" - which provider the LLM-driven nodes call by default
LLM_PROVIDER=groq

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Business configuration (safe demo defaults, override as needed) ----
DELAY_COMPENSATION_INR=100
DELAY_COMPENSATION_THRESHOLD_HOURS=48
REFUND_AUTO_APPROVE_MAX_INR=3000
RETURN_WINDOW_DAYS=10
REPEAT_CONTACT_ESCALATION_THRESHOLD=3
INTENT_CONFIDENCE_AUTO_THRESHOLD=0.75
LANGUAGE_CONFIDENCE_MIN=0.5

# ---- App ----
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173
API_PORT=8000
